# Arquivos de backup (muito grandes para Git)
backups/*.sql.gz
backups/*.sql
*.bak

# Logs
logs/*.log
*.log

# Arquivos temporários
*.tmp
*.temp

# Credenciais e secrets
.secrets/
*.key
*.pem

# Cache Python
__pycache__/
*.pyc
*.pyo

# Dados sensíveis dos pacientes (não versionar)
dados_pacientes/
exportacoes/
relatorios_individuais/

# WhatsApp Web.js session files (runtime, não versionar)
**/wwebjs_auth/session/Singleton*
**/wwebjs_auth/session/DevToolsActivePort
**/wwebjs_auth/session/Default/
**/wwebjs_auth/session/*.db
**/wwebjs_auth/session/*.db-journal